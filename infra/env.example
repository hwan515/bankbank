DOCKER_NETWORK=bankbank-net

# Backend core
DJANGO_SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=apibank.cocohwan.site,localhost,bank.cocohwan.site,192.168.0.69
CORS_ALLOWED_ORIGINS=https://bank.cocohwan.site
CSRF_TRUSTED_ORIGINS=https://bank.cocohwan.site,https://apibank.cocohwan.site

# Database
# Portainer stack 내부 MySQL 컨테이너를 사용할 때는 아래 기본값 유지
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=finance_db
MYSQL_USER=user
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_PUBLISHED_PORT=33306

# Redis
# Portainer stack 내부 Redis 컨테이너를 사용할 때는 아래 기본값 유지
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PUBLISHED_PORT=16379

# ChromaDB
# Portainer stack 내부 Chroma 컨테이너를 사용할 때는 아래 기본값 유지
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_COLLECTION=cards_top100_text
CHROMA_PUBLISHED_PORT=18001
EMBED_MODEL=text-embedding-3-large

# API keys
FIN_API_KEY=change-me-finlife-key
YOUTUBE_API_KEY=change-me-youtube-key
DATA_GO_KR_KEY=change-me-data-go-kr-key
KAKAO_REST_API_KEY=change-me-kakao-rest-key
GMS_KEY=change-me-gms-key
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
GMS_MODEL=gpt-4o-mini

# Frontend build
VITE_API_BASE_URL=https://apibank.cocohwan.site:443
VITE_WS_BASE_URL=wss://apibank.cocohwan.site:443
VITE_KAKAO_JS_KEY=change-me-kakao-js-key
